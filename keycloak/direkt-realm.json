{
  "realm": "direkt",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "organizationsEnabled": true,

  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": { "kc.user.profile.config": ["{\"unmanagedAttributePolicy\":\"ADMIN_EDIT\",\"attributes\":[{\"name\":\"username\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]}},{\"name\":\"email\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]}}]}"] }
      }
    ]
  },

  "clients": [
    {
      "clientId": "direkt-calltrainer",
      "name": "direkt-calltrainer",
      "description": "The only client that performs a login. Public + PKCE, because the SPA cannot keep a secret (ADR 0009).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "rootUrl": "http://localhost:8391",
      "baseUrl": "http://localhost:8391",
      "redirectUris": ["http://localhost:5173/*", "http://localhost:8391/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["basic", "acr", "web-origins", "profile", "email", "organization"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "direkt-calltrainer audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "direkt-calltrainer",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "direkt-calltrainer roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "direkt-calltrainer",
            "claim.name": "resource_access.direkt-calltrainer.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "id": "00000000-0000-4000-8000-000000000001",
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@company-a.example",
      "firstName": "Alice",
      "lastName": "Example",
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }]
    },
    {
      "id": "00000000-0000-4000-8000-000000000002",
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@company-a.example",
      "firstName": "Bob",
      "lastName": "Example",
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }]
    },
    {
      "id": "00000000-0000-4000-8000-000000000003",
      "username": "carol",
      "enabled": true,
      "emailVerified": true,
      "email": "carol@company-b.example",
      "firstName": "Carol",
      "lastName": "Example",
      "credentials": [{ "type": "password", "value": "carol", "temporary": false }]
    }
  ],

  "organizations": [
    {
      "name": "Company A",
      "alias": "company-a",
      "enabled": true,
      "domains": [{ "name": "company-a.example" }],
      "members": [{ "username": "alice" }, { "username": "bob" }]
    },
    {
      "name": "Company B",
      "alias": "company-b",
      "enabled": true,
      "domains": [{ "name": "company-b.example" }],
      "members": [{ "username": "carol" }]
    }
  ]
}

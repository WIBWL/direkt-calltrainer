{
  "realm": "direkt",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,

  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": { "kc.user.profile.config": ["{\"unmanagedAttributePolicy\":\"ENABLED\"}"] }
      }
    ]
  },

  "clients": [
    {
      "clientId": "calltrainer-frontend",
      "name": "calltrainer-frontend",
      "description": "The only client that performs a login. Public + PKCE, because the SPA cannot keep a secret (ADR 0009).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "rootUrl": "http://localhost:8391",
      "baseUrl": "http://localhost:8391",
      "redirectUris": ["http://localhost:5173/*", "http://localhost:8391/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["basic", "acr", "web-origins", "profile", "email"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "calltrainer-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "calltrainer",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "calltrainer roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "calltrainer-frontend",
            "claim.name": "resource_access.calltrainer.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "calltrainer tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "id": "00000000-0000-4000-8000-000000000001",
      "username": "niklas",
      "enabled": true,
      "emailVerified": true,
      "email": "niklas.heyder@solox.de",
      "firstName": "Niklas",
      "lastName": "Heyder",
      "attributes": { "tenant": ["solox"] },
      "credentials": [{ "type": "password", "value": "niklas", "temporary": false }]
    },
    {
      "id": "00000000-0000-4000-8000-000000000002",
      "username": "mathias",
      "enabled": true,
      "emailVerified": true,
      "email": "mathias.koehler@solox.de",
      "firstName": "Mathias",
      "lastName": "Köhler",
      "attributes": { "tenant": ["solox"] },
      "credentials": [{ "type": "password", "value": "mathias", "temporary": false }]
    },
    {
      "id": "00000000-0000-4000-8000-000000000003",
      "username": "eberhard",
      "enabled": true,
      "emailVerified": true,
      "email": "eberhard.hertling@appollo.systems",
      "firstName": "Eberhard",
      "lastName": "Hertling",
      "attributes": { "tenant": ["appollo"] },
      "credentials": [{ "type": "password", "value": "eberhard", "temporary": false }]
    }
  ]
}

[MAIN]
# Minimum Python version to use for version dependent checks
py-version=3.12

ignore=.venv,venv,dist,.git

# Alembic generates the revision files and drives them through `op`, whose
# members are attached at runtime -- pylint sees an empty module and reports
# E1101 for every operation. Excluded for the same reason as in .flake8: the
# files are generated, and a human reviews each one before it is applied.
# pylint matches this with re.match, so the `(^|.*[\\/])` prefix is what lets it
# hit the path however an editor passes it -- workspace-relative, absolute, or
# with Windows backslashes -- not just the repo-root-relative form.
ignore-paths=(^|.*[\\/])migrations[\\/]versions[\\/].*

# alembic.context and alembic.op are populated by Alembic at migration runtime,
# so a static read of either finds none of the members env.py / a revision
# legitimately calls (op.add_column etc.). parselmouth.praat is a submodule of a
# compiled C extension -- a static read cannot resolve the import (E0401).
ignored-modules=alembic.context,alembic.op,parselmouth.praat

# parselmouth is a compiled C extension (praat-parselmouth); pylint cannot see
# its members from a static read. Listing it here lets pylint import it for
# run-time introspection instead of reporting I1101 for every Sound/PraatError
# reference in backend/feedback/acoustics.py.
extension-pkg-allow-list=parselmouth

# Project root is the import root, so `backend.*` resolves in scripts/ (which
# add it to sys.path themselves at runtime). Uses source-roots rather than an
# init-hook that prepends "." to sys.path -- the latter shadows stdlib modules
# like collections.abc when pylint runs with a different working directory.
source-roots=.

[MESSAGES CONTROL]
# Responsibility: logic, design metrics, and docstrings only.
# PEP8 style and formatting is enforced by flake8 -- disabled here to avoid duplication.

# C: Convention, R: Refactor, W: Warning, E: Error, F: Fatal
disable=
    C0301,  # line-too-long   -- flake8 (E501) owns line length
    C0303,  # trailing-whitespace -- flake8 (W291/W293) owns this
    C0304,  # missing-final-newline -- flake8 (W292) owns this
    C0305,  # trailing-newlines -- flake8 (W391) owns this
    W0311,  # bad-indentation  -- flake8 (E1xx) owns this
    W0511,  # fixme            -- ignore TODO/FIXME comments
    W0611,  # unused-import    -- flake8 (F401) owns this
    W1203,  # logging-fstring-interpolation -- f-strings in logging calls
    C0114,  # missing-module-docstring -- not required for plain data/config modules
            # (personas.py, scenarios.py etc.) where the data speaks for itself;
            # function/method docstrings (C0116) are still enforced for actual logic.
    C0115,  # missing-class-docstring -- same reasoning, for simple dataclasses
            # (Persona, Scenario, PersonaVoice) whose fields are self-explanatory.
    R0903,  # too-few-public-methods -- SQLAlchemy models and dataclasses are
            # declarations, not behaviour; every class in backend/db/models.py
            # would otherwise be flagged forever.
    W0621,  # redefined-outer-name -- a pytest test takes its fixtures as
            # parameters named after them; this is the framework's design, not
            # shadowing. Unavoidable in tests/ and harmless elsewhere.

# Enable specific messages (overrides disable)
# enable=

[DESIGN]
# Maximum number of arguments for function / method
max-args=5

# Maximum number of locals for function / method body
max-locals=15

# Maximum number of return / yield for function / method body
max-returns=6

# Maximum number of statements in function / method body
max-statements=50

# Maximum number of parents for a class
max-parents=7

# Maximum number of attributes for a class
max-attributes=10

# Minimum number of public methods for a class
min-public-methods=2

# Maximum number of public methods for a class
max-public-methods=20

[SIMILARITIES]
# Minimum lines number of a similarity
min-similarity-lines=4

# Ignore comments when computing similarities
ignore-comments=yes

# Ignore docstrings when computing similarities
ignore-docstrings=yes

# Ignore imports when computing similarities
ignore-imports=yes

[REPORTS]
# Tells whether to display a full report or only the messages
reports=no

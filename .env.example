VITE_API_URL=http://localhost:8000

EFRE_URL=https://llm.efre-direkt.de
EFRE_API_KEY=<YOUR_API_KEY>

STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=Qwen3-4B-AWQ
TTS_MODEL=Voxtral-4B-TTS-2603

# Optional: set `LLM_BACKEND=gemini` to run dialogue generation against Gemini's
# OpenAI-compatible endpoint instead of EFRE_URL.
# LLM_BACKEND=gemini
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=<YOUR_API_KEY>
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: set `TTS_BACKEND=kugelaudio` to synthesize speech via the KugelAudio
# SDK instead of EFRE_URL. Not an OpenAI-compatible HTTP endpoint — uses the
# kugelaudio package directly.
# TTS_BACKEND=kugelaudio
KUGELAUDIO_API_KEY=<YOUR_API_KEY>
KUGELAUDIO_MODEL=kugel-2-turbo

POSTGRES_USER=trainer
POSTGRES_PASSWORD=<DEIN_DB_PASSWORT>
POSTGRES_DB=trainer

# Host-side connection (alembic, scripts/seed_reference_data.py).
# The app container gets its own URL pointing at "db" (compose.yaml).
DATABASE_URL=postgresql+psycopg://trainer:<DEIN_DB_PASSWORT>@localhost:5432/trainer
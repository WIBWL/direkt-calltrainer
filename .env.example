# Forces TTS onto the EFRE fallback below instead of KugelAudio
DEBUG=True

EFRE_URL=https://llm.efre-direkt.de
EFRE_API_KEY=<YOUR_API_KEY>
KUGELAUDIO_API_KEY=<YOUR_API_KEY>

STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=Qwen3-4B-AWQ
TTS_MODEL=Voxtral-4B-TTS-2603  # EFRE fallback, see DEBUG above
KUGELAUDIO_MODEL=kugel-3  # default TTS backend (measured: >= kugel-2-turbo on TTFA, faster on full synth; see docs/model-parameters.md)

POSTGRES_USER=trainer
POSTGRES_PASSWORD=<DEIN_DB_PASSWORT>
POSTGRES_DB=trainer
DATABASE_URL=postgresql+psycopg://trainer:<DEIN_DB_PASSWORT>@localhost:5432/trainer

# Keycloak / OIDC (ADR 0009). One issuer URL, shared: the backend's `iss` check,
# the SPA's authority. `docker compose up` brings its own Keycloak on :18081 and
# imports keycloak/direkt-realm.json (users alice/bob/carol, password = username).
# `compose.yaml` overrides OIDC_ISSUER and adds OIDC_JWKS_URL for the container.
# To use the deployed realm instead: https://keycloak.efre-direkt.de/realms/direkt
OIDC_ISSUER=http://localhost:18081/realms/direkt
VITE_OIDC_ISSUER=http://localhost:18081/realms/direkt
VITE_OIDC_CLIENT_ID=calltrainer-frontend

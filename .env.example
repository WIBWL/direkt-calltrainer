# Environment for running the Calltrainer on the host, matching the services in
# dev-compose.yaml. Copy it, fill in the two API keys, and source it into every
# shell you start a process from:
#
#   cp .env.example .env
#   source .env
#
# Keep the `export`s, or child processes won't see the values.
# Every variable is required; the processes refuse to start without one. Any
# can instead come from a file, as NAME_FILE=/path -- that is how a deployment
# hands over its secrets (docs/deployment.md).
# CORS_ORIGINS is left out on purpose: Vite proxies the API, so there's no CORS.

# --- backend and worker ------------------------------------------------------

# Host ports are shifted (15433, 16379) to avoid clashing with local installs
# and with the dataplatform's services.
export POSTGRES_URL='postgresql://postgres:postgres@localhost:15433/calltrainer'
export REDIS_URL='redis://localhost:16379'

# The OpenAI-compatible gateway (ADR 0011). Reachable only from the university
# network or its VPN.
export DIREKT_URL='https://llm.efre-direkt.de'
export DIREKT_API_KEY=''
export LLM_MODEL='gemma-4-26B-A4B-it'

# `pretty` for a terminal; the images log `json`.
export LOG_FORMAT='pretty'

# macOS only, and only for the worker: RQ forks per job, and macOS kills a forked
# child that touches a half-initialised system framework ("may have been in
# progress in another thread when fork() was called"). No effect elsewhere.
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY='YES'

# --- backend only ------------------------------------------------------------

export STT_MODEL='whisper-large-v3-turbo'
export KUGELAUDIO_API_KEY=''
export KUGELAUDIO_MODEL='kugel-3'

# --- backend and frontend ----------------------------------------------------

# Read by the backend and by the frontend (vite.config.ts serves it as
# /config.js, as the image's entrypoint does). They must match or every request
# 401s. The local Keycloak from dev-compose.yaml, dev users alice, bob,
# carol (password = username).
export OIDC_ISSUER='http://localhost:18081/realms/direkt'

VITE_API_URL=http://localhost:8000

EFRE_URL=https://llm.efre-direkt.de
EFRE_API_KEY=<YOUR_API_KEY>

STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=DeepSeek-V4-Flash-0731
TTS_MODEL=Voxtral-4B-TTS-2603
TTS_VOICE=de_male

# Optional: set LLM_BACKEND=gemini to run dialogue generation against Gemini's
# OpenAI-compatible endpoint instead of EFRE-DiReKT.

# LLM_BACKEND=gemini

GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=<YOUR_API_KEY>

GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: set TTS_BACKEND=kugelaudio to synthesize speech via the KugelAudio
# SDK instead of EFRE-DiReKT. Not an OpenAI-compatible HTTP endpoint — uses the
# kugelaudio package directly.

# TTS_BACKEND=kugelaudio

KUGELAUDIO_API_KEY=<YOUR_API_KEY>

KUGELAUDIO_MODEL=kugel-2-turbo
KUGELAUDIO_VOICE_ID=262

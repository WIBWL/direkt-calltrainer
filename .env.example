# Environment for the Calltrainer. Copy it and fill in the two secrets:
#
#   cp .env.example .env
#
# Read three ways, all expecting plain `KEY=value` (no `export`, no quotes):
# `load_dotenv()` for a host `uvicorn` run, `env_file:` in compose.yaml for the
# container, and Vite (its `envDir` is this directory) for the `VITE_*` vars.
#
# Every variable is REQUIRED unless its comment says otherwise — the backend
# reads each into a module-level constant at import and throws "(see
# .env.example)" if it is missing. `.env` is gitignored; this template is not.
# Secrets are left blank (fail cleanly at startup); other values you must choose
# are shown as <placeholders>.
#
# Deliberately absent: VITE_API_URL (the container serves the SPA same-origin as
# the API, so no base URL is needed) and OIDC_JWKS_URL (set only by compose.yaml,
# for the browser-vs-container host split — see the Keycloak section).

# --- Pipeline backends: STT + dialogue (DiReKT model gateway) ---------------

# The OpenAI-compatible model gateway for STT and dialogue (ADR 0011). Only
# reachable from its own network (VPN); `lifespan` checks it at boot.
DIREKT_URL=https://llm.efre-direkt.de

# Secret, left blank on purpose: an unset value fails cleanly at startup with
# "DIREKT_API_KEY is required", a wrong one only fails on the first request.
# LiteLLM key for DIREKT_URL — get one from the gateway operators.
DIREKT_API_KEY=

# One model name per step. Neither has a fallback: a dead model logs
# `Startup check: <STEP> FAILED` but does not stop the boot.
STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=Qwen3-4B-AWQ

# --- Optional: dialogue generation on Gemini (ADR 0074) ---------------------
#
# Off by default: dialogue generation runs on DIREKT_URL above, exactly as
# ADR 0011 says. Set GEMINI to a truthy value (1/true/yes) and it moves to
# Google's OpenAI-compatible endpoint instead — because the gateway has served
# nothing but the 4B model since the trial phase ended, and that is the binding
# quality limit. The five values below are then all REQUIRED; the app throws at
# import if one is missing, the same as for any other model name here.
#
# STT and TTS do NOT follow. They stay on the gateway and KugelAudio, so an
# actual call still needs DIREKT_URL reachable (VPN).
#
# Two models, and the split is deliberate: a fast one for the spoken reply and
# the call notes, a strong one for the wrap-up, the follow-up draft and the PDF
# summary. Measured 2026-09-08, time to first token — gemini-3.5-flash-lite at
# `minimal` 0.70 s, gemini-3.8-flash at `low` 2.98 s (and it defaults to
# `medium`). Three seconds before the first word is not a phone call.
#
# GEMINI_REASONING_EFFORT is the live model's thinking level and belongs to the
# model, not to taste: a value below what the model supports is a bare HTTP 400
# that names no parameter, so it looks like a Turn failing for no reason.
# gemini-3.5-flash-lite takes `minimal` and rejects `none`; gemini-3.8-flash
# bottoms out at `low`. Change the live model, re-check this line.
#
# The feedback model is 3.5-flash rather than the stronger 3.8: on the free tier
# 3.8-flash 429s at a quota of 20 requests, which a handful of finished Sessions
# exhausts, and a wrap-up that 429s is one the User never sees. With a paid key,
# gemini-3.8-flash is the upgrade.
#
# Before switching this on anywhere real Sessions are recorded: the spoken
# word then leaves for Google, and the privacy statement does not say so. It
# names the DiReKT gateway and KugelAudio as the processors and nobody else,
# so a statement that is accurate today is wrong the moment this flag is set.
# Naming Google there first is the precondition, not a follow-up task. ADR
# 0074 lists it under consequences; it is repeated here because this file is
# what somebody edits to turn it on, and the ADR is not.
#
# NOTE: this file is NOT gitignored — `.env` is. Real keys go there, never here.
GEMINI=
GEMINI_API_KEY=
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_LIVE_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_EFFORT=minimal
GEMINI_FEEDBACK_MODEL=gemini-3.5-flash-lite

# --- Pipeline backends: TTS (KugelAudio, with a DiReKT fallback) ------------

# Secret, left blank on purpose (same reason as DIREKT_API_KEY). KugelAudio is a
# separate hosted SDK (ADR 0040), the default on every synthesis call; a failure
# falls back to TTS_MODEL below. Not required when SKIP_KUGELAUDIO is set.
KUGELAUDIO_API_KEY=

# The KugelAudio model (docs/model-parameters.md).
KUGELAUDIO_MODEL=kugel-3

# The DiReKT TTS model — the KugelAudio fallback, or used always when SKIP_KUGELAUDIO is set.
TTS_MODEL=Voxtral-4B-TTS-2603

# Optional (default off). Truthy (1/true/yes) makes TTS skip KugelAudio, so the
# app runs without KugelAudio credentials.
# Named for the leg it moves, like GEMINI above. It was called DEBUG, which
# said nothing about TTS and read like a general verbosity switch — while it
# silently trades the hosted voice for a fallback measured 2-3x slower.
SKIP_KUGELAUDIO=

# Optional (default off). Truthy writes the spoken content of every call — what
# the user actually said — into the log file.
#
# Leave it empty outside local debugging. That log is personal data and no
# deletion path reaches it (ADR 0066), so a transcript written here survives
# both a withdrawn consent and a deleted training. The app logs a warning at
# boot while it is on.
LOG_TRANSCRIPTS=

# --- Database (Postgres, the `db` service in compose.yaml) ------------------

# The single source for these: compose.yaml's `db` service writes
# ${POSTGRES_USER} and friends, and Compose resolves those placeholders from
# this very file — so there is nothing to keep in sync by hand, and editing
# compose.yaml instead is what would create a mismatch. The password below is
# a placeholder; set a real one.
POSTGRES_USER=trainer
POSTGRES_PASSWORD=<YOUR_DB_PASSWORD>
POSTGRES_DB=trainer

# The connection URL is assembled from the three settings above in
# backend/db/session.py, so there is no DATABASE_URL to keep in sync here.
# Host and port only need setting when they differ from the defaults below;
# the app container and the worker get POSTGRES_HOST=db from compose.yaml.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# The Feedback queue (ADR 0019). Read lazily, like the database settings, and defaulted in
# code, so this only needs setting to point somewhere other than a local Redis;
# compose.yaml gives the app and worker containers the `redis`-host URL.
REDIS_URL=redis://localhost:6379

# --- Keycloak / OIDC (ADR 0009) --------------------------------------------

# The realm issuer URL. One value, three consumers (the `iss` check, the JWKS
# lookup, and as VITE_OIDC_ISSUER the SPA's authority) — they MUST agree, or
# every request 401s. `docker compose up` runs its own Keycloak on :18081 and
# imports keycloak/direkt-realm.json (users niklas/mathias/eberhard,
# password = username);
# compose.yaml then overrides this and adds OIDC_JWKS_URL. Deployed realm:
# https://keycloak.efre-direkt.de/realms/direkt
OIDC_ISSUER=http://localhost:18081/realms/direkt

# Same value, exposed to the browser (Vite only forwards VITE_-prefixed vars).
VITE_OIDC_ISSUER=http://localhost:18081/realms/direkt

# The public login client. A constant everywhere else; set here so the build is
# explicit.
VITE_OIDC_CLIENT_ID=calltrainer-frontend

# Environment for the Calltrainer. Copy it and fill in the two secrets:
#
#   cp .env.example .env
#
# Read three ways, all expecting plain `KEY=value` (no `export`, no quotes):
# `load_dotenv()` for a host `uvicorn` run, `env_file:` in compose.yaml for the
# container, and Vite (its `envDir` is this directory) for the `VITE_*` vars.
#
# Every variable is REQUIRED unless its comment says otherwise — the backend
# reads each into a module-level constant at import and throws "(see
# .env.example)" if it is missing. `.env` is gitignored; this template is not.
# Secrets are left blank (fail cleanly at startup); other values you must choose
# are shown as <placeholders>.
#
# Deliberately absent: VITE_API_URL (the container serves the SPA same-origin as
# the API, so no base URL is needed) and OIDC_JWKS_URL (set only by compose.yaml,
# for the browser-vs-container host split — see the Keycloak section).

# --- Pipeline backends: STT + dialogue (DiReKT model gateway) ---------------

# The OpenAI-compatible model gateway for STT and dialogue (ADR 0011). Only
# reachable from its own network (VPN); `lifespan` checks it at boot.
DIREKT_URL=https://llm.efre-direkt.de

# Secret, left blank on purpose: an unset value fails cleanly at startup with
# "DIREKT_API_KEY is required", a wrong one only fails on the first request.
# LiteLLM key for DIREKT_URL — get one from the gateway operators.
DIREKT_API_KEY=

# One model name per step. Neither has a fallback: a dead model logs
# `Startup check: <STEP> FAILED` but does not stop the boot.
STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=Qwen3-4B-AWQ

# --- Pipeline backends: TTS (KugelAudio, with a DiReKT fallback) ------------

# Secret, left blank on purpose (same reason as DIREKT_API_KEY). KugelAudio is a
# separate hosted SDK (ADR 0040), the default on every synthesis call; a failure
# falls back to TTS_MODEL below. Not required when DEBUG is set.
KUGELAUDIO_API_KEY=

# The KugelAudio model (docs/model-parameters.md).
KUGELAUDIO_MODEL=kugel-3

# The DiReKT TTS model — the KugelAudio fallback, or used always when DEBUG is set.
TTS_MODEL=Voxtral-4B-TTS-2603

# Optional (default off). Truthy (1/true/yes) makes TTS skip KugelAudio, so the
# app runs without KugelAudio credentials.
DEBUG=

# --- Database (Postgres, the `db` service in compose.yaml) ------------------

# Mirror compose.yaml's `db` service. Change one, change the others and
# DATABASE_URL. The password is a placeholder — set a real one.
POSTGRES_USER=trainer
POSTGRES_PASSWORD=<DEIN_DB_PASSWORT>
POSTGRES_DB=trainer

# Read lazily (first `session_scope()` call). `localhost` for host-side calls
# (alembic, seed script); the app container gets its own `db`-host URL from
# compose.yaml.
DATABASE_URL=postgresql+psycopg://trainer:<DEIN_DB_PASSWORT>@localhost:5432/trainer

# The Feedback queue (ADR 0019). Read lazily like DATABASE_URL, and defaulted in
# code, so this only needs setting to point somewhere other than a local Redis;
# compose.yaml gives the app and worker containers the `redis`-host URL.
REDIS_URL=redis://localhost:6379

# --- Keycloak / OIDC (ADR 0009) --------------------------------------------

# The realm issuer URL. One value, three consumers (the `iss` check, the JWKS
# lookup, and as VITE_OIDC_ISSUER the SPA's authority) — they MUST agree, or
# every request 401s. `docker compose up` runs its own Keycloak on :18081 and
# imports keycloak/direkt-realm.json (users alice/bob/carol, password = name);
# compose.yaml then overrides this and adds OIDC_JWKS_URL. Deployed realm:
# https://keycloak.efre-direkt.de/realms/direkt
OIDC_ISSUER=http://localhost:18081/realms/direkt

# Same value, exposed to the browser (Vite only forwards VITE_-prefixed vars).
VITE_OIDC_ISSUER=http://localhost:18081/realms/direkt

# The public login client. A constant everywhere else; set here so the build is
# explicit.
VITE_OIDC_CLIENT_ID=calltrainer-frontend

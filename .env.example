VITE_API_URL=http://localhost:8000

# Forces TTS onto the EFRE fallback below instead of KugelAudio
DEBUG=True

EFRE_URL=https://llm.efre-direkt.de
EFRE_API_KEY=<YOUR_API_KEY>
KUGELAUDIO_API_KEY=<YOUR_API_KEY>

STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=Qwen3-4B-AWQ
TTS_MODEL=Voxtral-4B-TTS-2603  # EFRE fallback, see DEBUG above
KUGELAUDIO_MODEL=kugel-2-turbo  # default TTS backend

POSTGRES_USER=trainer
POSTGRES_PASSWORD=<DEIN_DB_PASSWORT>
POSTGRES_DB=trainer
DATABASE_URL=postgresql+psycopg://trainer:<DEIN_DB_PASSWORT>@localhost:5432/trainer

# Environment for the Calltrainer. `cp .env.example .env` and fill in the
# secrets, which are left blank here so a missing one fails at startup.
#
# Read three ways, all expecting plain `KEY=value` (no `export`, no quotes):
# `load_dotenv()` for a host `uvicorn` run, `env_file:` in compose.yaml for the
# container, and Vite (its `envDir` is this directory) for the build-time
# frontend values. `.env` is gitignored; this template is not, so real keys go
# there and never here.
#
# Every variable is required unless its comment says otherwise.

# --- STT + dialogue: one OpenAI-compatible endpoint, one model per step ------

# The EFRE-DiReKT gateway by default, reachable only from its own network
# (VPN). Any OpenAI-compatible endpoint works; the model names below are what
# decides what runs (ADR 0011, ADR 0103).
DIREKT_URL=https://llm.efre-direkt.de
DIREKT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
# The spoken reply and everything written after the call (wrap-up, follow-up
# draft, PDF summary). The sampling in backend/clients/llm.py was measured
# against this model -- see docs/research/model-parameters.md before changing it.
LLM_MODEL=Qwen3-4B-AWQ

# --- Speech output: KugelAudio ----------------------------------------------

# The only speech backend there is (ADR 0103): a failure ends the Turn rather
# than falling back to another voice.
KUGELAUDIO_API_KEY=
KUGELAUDIO_MODEL=kugel-3

# --- Logging ----------------------------------------------------------------

# Optional (default off). Truthy (1/true/yes) writes the spoken content of
# every call into the log file. That log is personal data and no deletion path
# reaches it (ADR 0066), so leave it empty outside local debugging; the app
# logs a warning at boot while it is on.
LOG_TRANSCRIPTS=

# --- Database (Postgres, the `db` service in compose.yaml) ------------------

# compose.yaml's `db` service resolves ${POSTGRES_USER} and friends from this
# file, so there is nothing to keep in sync by hand. The connection URL is
# assembled from the three in backend/db/session.py -- there is no DATABASE_URL.
POSTGRES_USER=trainer
POSTGRES_PASSWORD=<YOUR_DB_PASSWORD>
POSTGRES_DB=trainer

# Optional: only needed when they differ from the defaults below. The app and
# worker containers get POSTGRES_HOST=db from compose.yaml.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# The Feedback queue (ADR 0019). compose.yaml points the containers at the
# `redis` service; this value is for a host-side run.
REDIS_URL=redis://localhost:6379

# --- Keycloak / OIDC (ADR 0009) --------------------------------------------

# One issuer, two consumers: the backend's `iss` check and JWKS lookup, and the
# SPA's authority, which Vite reads from here at build time (`envPrefix` in
# frontend/vite.config.ts). `docker compose up` runs its own Keycloak on :18081
# and imports keycloak/direkt-realm.json (users niklas/mathias/eberhard,
# password = username); compose.yaml then overrides this and adds
# OIDC_JWKS_URL, which resolves the browser-vs-container host split.
# Deployed realm: https://keycloak.efre-direkt.de/realms/direkt
OIDC_ISSUER=http://localhost:18081/realms/direkt

# The public login client.
OIDC_CLIENT_ID=calltrainer-frontend

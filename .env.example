LLM_URL=https://llm.efre-direkt.de
LLM_API_KEY=<YOUR_API_KEY>
LLM_MODEL=Qwen3-4B

# STT/TTS run as local vLLM servers, not via LLM_URL - see ADR 0022
STT_URL=http://localhost:8025
STT_MODEL=openai/whisper-large-v3-turbo
TTS_URL=http://localhost:8091
TTS_MODEL=mistralai/Voxtral-4B-TTS-2603
TTS_VOICE=vivian

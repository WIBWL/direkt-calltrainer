# Environment for the Calltrainer. `cp .env.example .env` and fill in the blanks.
# Only secrets, dev/deploy differences and the model names live here; everything
# else is a constant in the code (docs/deployment.md lists where).
# Plain `KEY=value`, no `export`, no quotes: read by load_dotenv(), compose's env_file
# and Vite (OIDC_ISSUER). This template is committed, so real keys never go here.

# --- Secrets: required in development and deployment ------------------------

DIREKT_API_KEY=
KUGELAUDIO_API_KEY=

# Applied by Postgres only when its volume is first created -- set it before
# the first start. `openssl rand -base64 32` for a deployment.
POSTGRES_PASSWORD=

# --- Differs between development and deployment -----------------------------

# The Keycloak realm: the token issuer the backend checks, and the login the
# SPA is built against (so changing it needs `--build`).
#   development: the Keycloak compose.yaml brings along (users niklas, mathias,
#                eberhard; password = username)
#   deployment:  https://keycloak.efre-direkt.de/realms/direkt
OIDC_ISSUER=http://localhost:18081/realms/direkt

# The OpenAI-compatible gateway. Reachable only from the university network or
# its VPN, so a server outside it may need a different route here.
DIREKT_URL=https://llm.efre-direkt.de

# --- Models: the same in development and deployment --------------------------

STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=Qwen3-4B-AWQ
KUGELAUDIO_MODEL=kugel-3

# --- Deployment only (compose.prod.yaml) ------------------------------------

# The public host name Caddy requests the TLS certificate for, without
# https://. Leave empty in development.
CALLTRAINER_DOMAIN=

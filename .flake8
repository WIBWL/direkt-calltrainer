[flake8]
# E261: at least two spaces before inline comment
# W293: blank line contains whitespace
# W504: line break after binary operator
# W291: trailing whitespace
# E221: multiple spaces before operator -- allows aligning a block of related
#       constant assignments into columns, same taste as E261 above
ignore = E261, W293, W504, W291, E221
max-line-length = 120
max-complexity = 10

# Alembic writes the files under versions/ itself, in its own layout — its
# continuation-line style trips E122/E128 on every single revision. Reformatting
# generated code by hand would just be undone by the next `alembic revision`.
# The migrations are still reviewed by a human before they are applied; see
# CLAUDE.md, "Schema changes".
exclude =
    .git,
    .venv,
    __pycache__,
    frontend/node_modules,
    backend/db/migrations/versions,
    test

# When an editor lints one migration file by its full path, `exclude` above does
# not apply (flake8 only filters files it discovers itself, not ones passed
# explicitly). autogenerate's continuation-line layout under op.create_table
# trips the whole E12x family; ignore it there, the same call `exclude` makes.
per-file-ignores =
    backend/db/migrations/versions/*: E12

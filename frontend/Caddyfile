# Local development: serves the built SPA and forwards everything the backend
# owns, so the browser talks to one origin. In deployment static.Caddyfile runs
# instead and the external reverse proxy does the forwarding.
{
	admin off
}

:80 {
	encode zstd gzip

	# The API, the live session's WebSocket (upgrade passed through by itself,
	# no read timeout) and the health checks. An unknown path under these must
	# answer from the backend, never with the SPA's HTML.
	@backend path /api* /ws* /health*
	handle @backend {
		reverse_proxy backend:8000
	}

	import spa.caddy
}

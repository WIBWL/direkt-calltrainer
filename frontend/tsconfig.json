{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    // Maximum strictness — a type hole here becomes a runtime bug in the
    // browser, where it is hardest to trace back.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // The Vitest specs and their fakes are transpiled by esbuild (`npm test`),
  // never emitted — keep them out of the production type-check/build so their
  // test-only globals don't have to be wired into this config.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"]
}
